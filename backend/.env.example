# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Agent LLM — provider is one of: anthropic, google, openai_compatible
# api_key falls back to the provider's own env var (GOOGLE_API_KEY, etc.) if unset here.
# base_url is required for openai_compatible (e.g. a local server) and optional otherwise.
LLM__PROVIDER=google
LLM__MODEL=gemini-2.5-flash
LLM__API_KEY=
LLM__BASE_URL=

# Local LLM server, run independently of this project (~/models/vllm/ — see
# backend/README.md). To use it as the agent's LLM: LLM__PROVIDER=openai_compatible,
# LLM__MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ, LLM__BASE_URL=http://localhost:8001/v1, and
# LLM__API_KEY set to the value of ~/models/vllm/.env's VLLM_API_KEY.

# Postgres (tracks, computed routes, chat sessions)
POSTGRES__HOST=localhost
POSTGRES__PORT=5433
POSTGRES__DATABASE=shadowbot
POSTGRES__USERNAME=shadowbot
POSTGRES__PASSWORD=shadowbot

# Routing: pure-Python (osmnx + networkx) backend over locally cached OSM graph tiles.
# Tiles are fetched on demand, scoped to whatever area a request actually needs (not a
# pre-configured region), and cached to disk under cache_dir. overpass_url should point
# at a self-hosted instance (see docker-compose.yml's overpass service) rather than the
# public API, which is frequently overloaded — set up via `docker compose up -d overpass`
# after downloading a regional PBF extract into the mounted /db directory.
ROUTING__CACHE_DIR=/home/boltonn/data/openstreetmap
ROUTING__OVERPASS_URL=http://localhost:12345/api

# Routing (optional, faster): Valhalla, run in-process over a pre-built tile set — no
# separate service. Requires the valhalla extra (`uv sync --extra valhalla`) and a
# one-time tile build (see backend/README.md). Set VALHALLA__TILE_URI and this backend
# replaces the networkx one above; leave it unset to keep using networkx/Overpass.
# tile_uri accepts a local path to a .tar extract or tile directory, or an s3://
# bucket/key.tar URI (downloaded once into VALHALLA__CACHE_DIR on first use).
VALHALLA__TILE_URI=
VALHALLA__CACHE_DIR=/home/boltonn/data/valhalla

# Geocoding — Nominatim usage policy requires a descriptive User-Agent
GEOCODING__NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODING__USER_AGENT=shadowbot/0.1 (set to identify your deployment)
